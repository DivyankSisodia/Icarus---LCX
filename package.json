{
  "name": "lcx",
  "version": "0.1.0",
  "description": "LeetCode Terminal Client — solve problems from your terminal",
  "main": "dist/index.js",
  "bin": {
    "lcx": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "format": "prettier --write src/"
  },
  "keywords": ["leetcode", "cli", "competitive-programming"],
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.2",
    "better-sqlite3": "^11.1.2",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "fs-extra": "^11.2.0",
    "ora": "^8.0.1",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.10",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.14.2",
    "eslint": "^9.4.0",
    "prettier": "^3.3.1",
    "tsup": "^8.1.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
